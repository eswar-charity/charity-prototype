APP_NAME=Charity Hub API
# development | test | production. In production the API refuses to start with a weak JWT_SECRET
# and returns 503 for payments unless Stripe is configured.
ENVIRONMENT=development

# Supabase Postgres (asyncpg). Use the pooler/session connection string.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
# Local Postgres for running the test suite (docker-compose default below)
TEST_DATABASE_URL=postgresql+asyncpg://charity:charity@localhost:5433/charity_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"  (>= 32 chars in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call the API (add every deployed frontend URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Public URL of the frontend: used in invite links and Stripe onboarding return URLs.
PUBLIC_BASE_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Google Identity Services — Web client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (Connect, destination charges). Leave STRIPE_SECRET_KEY empty for the
# dev-only mock provider; it is never used when ENVIRONMENT=production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secrets (whsec_...). Create TWO endpoints pointing at
# https://<api-host>/api/v1/webhooks/stripe — one for "Your account" events and
# one for "Connected accounts" events — each has its own secret. See README.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# true = accept donations for nonprofits that haven't finished Stripe onboarding
# (funds stay on the platform account). Default false.
ALLOW_UNCONNECTED_NONPROFITS=false
